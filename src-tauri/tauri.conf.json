{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "token-fire",
  "version": "0.1.0",
  "identifier": "com.tokenfire.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "token-fire",
        "width": 152,
        "height": 190,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false
      },
      {
        "label": "settings",
        "title": "token-fire 设置",
        "url": "panel.html",
        "width": 300,
        "height": 766,
        "visible": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": false
      },
      {
        "label": "deepseek",
        "title": "DeepSeek 用量",
        "url": "deepseek.html?page=usage",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "resizable": true,
        "maximizable": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
